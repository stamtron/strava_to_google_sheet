# ── Credentials (required) ────────────────────────────────────────────────────
STRAVA_CLIENT_ID=your_strava_client_id
STRAVA_CLIENT_SECRET=your_strava_client_secret
GOOGLE_SHEET_ID=your_google_sheet_id
GARMIN_EMAIL=your_garmin_email@example.com
GARMIN_PASSWORD=your_garmin_password
GEMINI_API_KEY=your_gemini_api_key

# ── Web server (optional) ─────────────────────────────────────────────────────
# The API is unauthenticated, so it binds to loopback by default. Only change
# SERVER_HOST if you understand that anyone on the network can then read your
# training and biometric data.
# SERVER_HOST=127.0.0.1
# SERVER_PORT=8000
# Comma-separated CORS origins. Defaults to localhost/127.0.0.1 on SERVER_PORT.
# ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# ── Strava OAuth & rate limiting (optional) ───────────────────────────────────
# Port for the local OAuth callback listener. Must differ from SERVER_PORT.
# Register `localhost` as the Authorized Callback Domain at
# https://www.strava.com/settings/api — the domain is checked, not the port.
# STRAVA_REDIRECT_PORT=8123
# Pause between per-activity detail requests (Strava allows 200 req / 15 min).
# STRAVA_DETAIL_DELAY_SEC=0.15
# Retries on HTTP 429, honouring Retry-After.
# STRAVA_MAX_RETRIES=3

# ── Cache lifetimes, in seconds (optional) ────────────────────────────────────
# ACTIVITIES_CACHE_TTL=600
# GARMIN_CACHE_TTL=21600
# WEATHER_CACHE_TTL=10800

# ── Athlete Location & Weather (optional) ────────────────────────────────────
# Default location is Athens, Greece (Open-Meteo API, no key required).
# ATHLETE_CITY=Athens, Greece
# ATHLETE_LATITUDE=37.9838
# ATHLETE_LONGITUDE=23.7275
# ATHLETE_TIMEZONE=Europe/Athens

# ── History store (optional) ──────────────────────────────────────────────────
# `main.py --backfill` walks every page of your Strava history into a local
# SQLite store so analytics can look back further than the last fetched page.
# Activities per page. Strava caps this at 200.
# STRAVA_BACKFILL_PAGE_SIZE=200
# Runaway guard, not a real limit — at 200/page this covers 20 000 activities.
# STRAVA_BACKFILL_MAX_PAGES=100
# Pause between pages, on top of the 429 handling in the Strava client.
# STRAVA_BACKFILL_PAGE_DELAY_SEC=0.5

# ── Athlete physiology (optional) ─────────────────────────────────────────────
# Used by the TRIMP relative-effort estimate when Strava reports no Suffer Score.
# HR_MAX=185
# HR_REST=50

# ── Sport data corrections (optional) ─────────────────────────────────────────
# Divisor for swim distance/speed. Set to 1 if your watch reports pool swims
# correctly; 2 corrects double-counted lengths.
# SWIM_DISTANCE_DIVISOR=2.0
# Nominal speed used to estimate distance for indoor trainer rides that report 0.
# INDOOR_BIKE_SPEED_KMH=21.0

# ── ACWR (optional) ───────────────────────────────────────────────────────────
# Chronic load = mean weekly load over the N weeks *preceding* the scored week.
# ACWR_CHRONIC_WEEKS=4
# Below this many prior weeks, no ratio is reported rather than a misleading one.
# ACWR_MIN_CHRONIC_WEEKS=2

# ── Run durability (optional) ─────────────────────────────────────────────────
# Safe week-over-week run volume increase, as a percentage (the "10% rule").
# RUN_RAMP_SAFE_PCT=10.0
# Largest share of weekly run volume a single long run should occupy.
# RUN_LONG_RUN_MAX_SHARE=0.40
# Non-running days per week needed for tissue remodelling.
# RUN_MIN_REST_DAYS=2
# Foster monotony (mean daily load / SD) and strain (weekly load × monotony).
# MONOTONY_WARN_THRESHOLD=2.0
# STRAIN_WARN_THRESHOLD=1500.0
# Run-equivalent aerobic stimulus per minute of impact-free cross-training.
# AQUA_JOG_LOAD_FACTOR=0.90
# BIKE_RUN_LOAD_FACTOR=0.55

# ── AI coach (optional) ───────────────────────────────────────────────────────
# Comma-separated Gemini models, tried in order until one succeeds. Google
# retires model IDs on a rolling basis (gemini-2.0-flash now returns 404), so
# this is a fallback chain with the newest generation first.
# GEMINI_MODELS=gemini-3.6-flash,gemini-2.5-flash

# ── Conversational coach — POST /api/ai/chat (optional) ───────────────────────
# A separate model list from GEMINI_MODELS: the chat agent needs function
# calling, so a model that can serve the one-shot weekly panel is not
# automatically valid here.
# COACH_CHAT_MODELS=gemini-3.6-flash,gemini-2.5-flash
# Ceiling on the automatic tool-calling loop for a single turn, so a model that
# keeps re-querying its own data cannot spend unbounded requests on one question.
# COACH_MAX_TOOL_CALLS=8
# How long an idle conversation survives, in seconds (default 7 days), measured
# from its last message rather than its first.
# COACH_SESSION_TTL=604800
# Most recent messages replayed as history each turn. Older turns stay on disk,
# they just leave the prompt.
# COACH_MAX_HISTORY_MESSAGES=24

# ── Coach memory (optional) ───────────────────────────────────────────────────
# Durable facts recalled and injected into the system instruction per turn.
# COACH_MEMORY_TOP_K=5
# Which memory implementation backs `remember_fact`. Both expose the same four
# methods: "chroma" recalls by meaning and costs one embedding request per write
# and per turn, "sqlite" recalls by keyword overlap and costs nothing.
# COACH_MEMORY_BACKEND=sqlite
# Embedding model for the Chroma backend. Chroma's own default would pull
# onnxruntime and download model weights on first use, so the Gemini key that is
# already configured is used instead.
# COACH_EMBEDDING_MODEL=gemini-embedding-001
# COACH_MEMORY_COLLECTION=athlete_memory
# Ceiling on facts the end-of-conversation extraction pass may store from one
# transcript. A memory of everything recalls nothing useful.
# COACH_AUTO_FACT_LIMIT=5

# ── Verified race PBs, in seconds (optional) ──────────────────────────────────
# Official race results, not training bests. They calibrate the PB-mode race and
# triathlon projections and are quoted in the coach's athlete profile, so a stale
# value here misleads both. Defaults are this repo owner's results.
# ATHLETE_PB_HALF_MARATHON_SEC=6415   # 1h 46m 55s
# ATHLETE_PB_10K_SEC=3015             # 50m 15s
# ATHLETE_PB_5K_SEC=1395              # 23m 15s
# ATHLETE_PB_SPRINT_TRI_SEC=4532      # 1h 15m 32s
# ATHLETE_PB_OLYMPIC_TRI_SEC=8647     # 2h 24m 07s
# ATHLETE_PB_AQUATHLON_SEC=2234       # 37m 14s
# Race-day swim and bike baselines for the PB-calibrated triathlon projection.
# Set explicitly rather than derived from the triathlon PBs above: a finish time
# cannot be split back into legs. The run baseline comes from ATHLETE_PB_5K_SEC.
# ATHLETE_RACE_SWIM_100M_SEC=100.0    # 1:40 /100m
# ATHLETE_RACE_BIKE_SPEED_KMH=32.5
